generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id               String   @id @default(uuid())
  title            String
  shortDescription String
  fullDescription  String
  technologies     String[]
  images           String[]
  video            String?
  status           String   @default("Completed") // "Completed" or "In Progress"
  githubLink       String?
  liveDemoLink     String?
  downloadLink     String?
  dateDeveloped    DateTime?
  myRole           String?
  isFeatured       Boolean  @default(false)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
